# Copy to .env.local for local development, or set these in the hosting
# provider (Vercel project settings) for deployed builds.
#
# The production build fails fast when VITE_API_BASE_URL is missing, and it
# refuses any non-HTTPS value, so a deploy cannot silently point at localhost.
# For local development use: VITE_API_BASE_URL=http://localhost:8000/api
VITE_API_BASE_URL=https://api.beautifulbrowsandhenna.com/api
